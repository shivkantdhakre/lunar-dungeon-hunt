PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
# LOCAL DEVELOPMENT SETUP INSTRUCTIONS (P2.6):
# These placeholder sentinels intentionally FAIL CLOSED outside NODE_ENV=test.
# To generate separate high-entropy 32-byte hex keys for local development, run:
#   node -e "console.log('AUTH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log('HOST_ADMIN_KEY=' + require('crypto').randomBytes(32).toString('hex'))"
# Or using OpenSSL:
#   openssl rand -hex 32
# DO NOT commit generated secrets to version control.
# ==============================================================================
# SECRETS MUST BE AT LEAST 32 CHARACTERS AND GENERATED VIA CRYPTOGRAPHIC ENTROPY.
AUTH_SECRET=REPLACE_WITH_OPENSSL_GENERATED_32_BYTE_HEX_AUTH_SECRET
HOST_ADMIN_KEY=REPLACE_WITH_OPENSSL_GENERATED_32_BYTE_HEX_HOST_ADMIN_KEY
